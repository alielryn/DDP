<style>
    body{
        font-family: 'segoe UI', Arial, sans-serif;
        margin: 0; background-color: #fcfeff; color: #222;
    }
    /*Ini Settingan buat HEADER*/
    header {
        background-color: #355485;
        color: white; text-align: center;
        padding: 20px 0;
    }
    header h1 {
        margin: 0; font-size: 28px;
    }
    /*Ini settingan buat Navigasi*/
    nav {
        background-color: #4f90c6; 
        text-align: center; padding: 10px 0;
    }
    nav a {
        color: white; text-decoration: none; 
        margin: 0 15px; font-weight: bold;
    }
    nav a:hover {
        text-decoration: underline
    }
    /*LAYOUT*/
    .container {
        width: 90%; max-width: 1100px;
        margin: 20px auto; overflow: auto; margin-left: 20px
        ;
    }
    section {
        float: left; width: 68%; background-color: white;
        border: 1px solid #ddd; border-radius: 8px;
        padding: 16px; box-sizing: border-box;
    }
    aside {
        float: right; width: 28%; background-color: #cbdde9;
        border: 1px solid #bbb; border-radius: 8px;
        padding: 16px; box-sizing: border-box; margin-top: 10px;
        /*float: right;
          width: 30%;
