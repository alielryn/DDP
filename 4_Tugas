    }
    h2 {
        color: #355485; margin-top: 0;
    }
    article img {
        width: 100%; border-radius: 6px; margin-bottom: 10px;
    }
    /*Ini buat TABLE DATA*/
    table {
        border-collapse: collapse; width: 100%; margin: 12px 0;
    }
    th,
    td {
        border: 1px solid #ccc; padding: 8px;
        text-align: left;
    }
    th {
        background-color: #f1f5f9;
    }
    /*IFRAME*/
    iframe {
        width: 100%; height: 250px; border: 1px solid #999; border-radius: 6px;
    }
    /*FOOTER*/
    footer {
        clear: both; background-color: #355485; color: white; 
        text-align: center; padding: 14px 0; margin-top: 20px;
    }
    footer a {
        color: #cbdde9; text-decoration: none;
    }
    footer a:hover {
        text-decoration: underline;
    }
    /*gatau ini dari kakaknya "RESPONSIVE SEDIKIT" katanya*/
    @media (max-widht: 768px) {
        section,
        aside {
            float: none; width: 100%;
        } 
    }
</style>
